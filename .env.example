# SUPABASE: Conexión obligatoria con proyecto Supabase (Authentication, PostgreSQL, Storage, Realtime)
# Obtén estos valores en Supabase Dashboard -> Project Settings -> API
# Nunca incluyas SUPABASE_SERVICE_ROLE_KEY en variables VITE_* ni en el código del navegador.
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-supabase-anon-public-key"

# CONFIGURACIÓN TERRITORIAL E INSTITUCIONAL
VITE_DEFAULT_TIMEZONE="America/Santiago"
VITE_APP_NAME="PoliCircular"

# APP_URL: Inyectada automáticamente en tiempo de ejecución si corresponde.
APP_URL="MY_APP_URL"
